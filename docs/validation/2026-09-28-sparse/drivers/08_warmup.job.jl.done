let F=SparseBenchFinal,t=SparseBenchFinal.frozen("core")
    a=t.anchor;start=time()
    p=F.sparse_conditional_fit(a.graph;axes=t.axes,chart=F.AffineChart(t.center,t.scale),lower=[-4.],upper=[4.],
        max_nodes=1,screen_only=true,shape_key=a.key_z,curvature=F.polished_gn_conditional_curvature,
        step_bounds=Dict(a.key_z=>a.latent_step),newton_tol=E.ONLINE_NEWTON_TOL)
    println("COOK WARMUP ",(seconds=time()-start,shape=p.diagnostics.shape_defect))
end