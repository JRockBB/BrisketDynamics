module DirectFixedRun
const E=Main.E
using Main.BrisketEstimator, BrisketDynamics, LinearAlgebra, Random, JSON, Statistics, Serialization, Test
include(joinpath(@__DIR__,"../../estimator/scripts/direct_online.jl"))
end
let model=consistency_model(nx=4,stop=120.,suite=:core)
    p=DirectFixedRun.direct_posterior_fit(online_init(model;lag=typemax(Int));max_evaluations=15000,max_seconds=120.)
    println("PRIOR ",(resolved=p.diagnostics.resolved,reason=p.diagnostics.reason,Z=p.normalizer,eval=p.diagnostics.evaluations,valid=p.diagnostics.moments_valid,wall=p.diagnostics.wall))
    @test p.diagnostics.resolved
    @test p.mean[1:length(model.blk)]≈[z_moments(s)[1] for s in model.blk.sites] atol=1e-8
    @test p.covariance[1:length(model.blk),1:length(model.blk)]≈Matrix(Diagonal([z_moments(s)[2] for s in model.blk.sites])) atol=1e-8
end
let sm,r,truth=direct_core_case,model=sm.model
    progress=h->(h.evaluations%1000<80 ? (println("FIXED ",h);flush(stdout)) : nothing)
    global direct_core_fixed=DirectFixedRun.direct_posterior_fit(sm;max_evaluations=100000,max_seconds=600.,progress)
    p=direct_core_fixed;nz=length(model.blk);err=p.mean-vcat(truth.z,truth.y)
    record=(diagnostics=p.diagnostics,mean=p.mean,covariance=p.covariance,physical_mean=p.physical_mean,
        physical_variance=p.physical_variance,truth=vcat(truth.z,truth.y),
        nees_z=p.diagnostics.moments_valid ? dot(err[1:nz],p.covariance[1:nz,1:nz]\err[1:nz])/nz : nothing,
        nees_y=p.diagnostics.moments_valid ? dot(err[nz+1:end],p.covariance[nz+1:end,nz+1:end]\err[nz+1:end])/model.bl.n : nothing,
        gaussian_nees_y=dot(r.y-truth.y,r.y_cov\(r.y-truth.y))/model.bl.n)
    write(joinpath(@__DIR__,"core_direct_fixed.json"),E.json_document(record))
    println("FIXED CORE RESULT ",(resolved=p.diagnostics.resolved,reason=p.diagnostics.reason,Z=p.normalizer,eval=p.diagnostics.evaluations,valid=p.diagnostics.moments_valid,wall=p.diagnostics.wall,nees=record.nees_y));flush(stdout)
end