module MappedRun
const E=Main.E
const archived=joinpath(@__DIR__,"../../docs/validation/2026-09-28-transport/sources/benchmark")
include(joinpath(archived,"adaptive_density.jl"))
include(joinpath(archived,"conditional_charts.jl"))
include(joinpath(archived,"adaptive_conditional.jl"))
end
let F=SparseBenchFinal,t=deserialize(joinpath(@__DIR__,"../transport_work/late_two_target.jls"))
    a=t.anchor;before=F.target_state_fingerprint(a);start=time();candidates=Dict{String,Any}()
    for name in ("late_two_sparse","late_two_mapped_sparse")
        path=joinpath(@__DIR__,name*".jls");isfile(path) && (candidates[name]=(module_=F,p=deserialize(path)))
    end
    for name in ("late_two_affine","late_two_triangular")
        candidates[name]=(module_=MappedRun,p=deserialize(joinpath(@__DIR__,"../transport_work",name*".jls")))
    end
    rows=NamedTuple[];xs,ws=F.AdaptiveDensities._legendre(3)
    for i in 1:3,j in 1:3
        q=4 .* [xs[i],xs[j]].-2;z=t.center+t.scale*q
        reference=F.sparse_conditional_fit(a.graph;axes=t.axes,center=z,scale=Matrix{Float64}(I,2,2),
            lower=fill(-1.,2),upper=fill(1.,2),screen_only=true,max_nodes=1,
            curvature=F.polished_gn_conditional_curvature,step_bounds=Dict(a.key_z=>a.latent_step),newton_tol=E.ONLINE_NEWTON_TOL)
        actual=F.adaptive_geometry(reference.density,zeros(2));comparisons=NamedTuple[]
        for name in sort(collect(keys(candidates)))
            item=candidates[name];M=item.module_;p=item.p
            E._same_conditional_decoder(reference.decoder,p.decoder) || error("different decoder")
            p.axes==reference.axes && p.free==reference.free || error("different coordinates")
            qp=M.chart_inverse(p.chart,z)
            if !(all(p.density.diagnostics.lower.<=qp) && all(qp.<=p.density.diagnostics.upper))
                push!(comparisons,(method=name,outside=true));continue
            end
            n=M.adaptive_geometry(p.density,qp)
            node=F.AdaptiveDensities.Node((logmass=n.logmass-M.chart_logjac(p.chart,qp),mean=n.mean,root=n.root))
            push!(comparisons,(method=name,outside=false,absolute_logmass_error=abs(node.logmass-actual.logmass),
                conditional_kl=F.AdaptiveDensities._kl(actual,node),reverse_kl=F.AdaptiveDensities._kl(node,actual)))
        end
        push!(rows,(q=q,point=z,quadrature_weight=16ws[i]*ws[j],logmass=actual.logmass,comparisons=comparisons))
        println("COMMON OFFGRID ",last(rows));flush(stdout)
    end
    write(joinpath(@__DIR__,"common_offgrid.json"),F.adaptive_strict_json((rows=rows,wall=time()-start,
        extra_fits=length(rows),within_comparison_budget=false,grid=:central_affine_gauss3,
        graph_unchanged=before==F.target_state_fingerprint(a),true_posterior_bound=false)))
end