module VerifiedSparseCapacity
using LinearAlgebra,Serialization,SHA
const E=Main.E
const ROOT=normpath(joinpath(@__DIR__,"../.."))
include(joinpath(ROOT,"docs/validation/2026-09-28-sparse/sources/final/estimator/scripts/validate_sparse.jl"))
for name in ("core","two_core")
    t=Main.SparseBenchFinal.frozen(name);a=t.anchor;before=target_state_fingerprint(a)
    sparse_conditional_fit(a.graph;axes=t.axes,chart=AffineChart(t.center,t.scale),lower=[-4.],upper=[4.],
        max_nodes=1,screen_only=true,curvature=polished_gn_conditional_curvature,
        step_bounds=Dict(a.key_z=>a.latent_step),newton_tol=E.ONLINE_NEWTON_TOL)
    start=time()
    p=sparse_conditional_fit(a.graph;axes=t.axes,chart=AffineChart(t.center,t.scale),lower=[-4.],upper=[4.],
        shape_key=a.key_z,max_nodes=129,max_degree=64,tolerance=.002,orders=(7,11),
        curvature=polished_gn_conditional_curvature,step_bounds=Dict(a.key_z=>a.latent_step),newton_tol=E.ONLINE_NEWTON_TOL,
        checkpoint=()->(time()-start<=600 || throw(SparseTimeLimit())),progress=h->(println("verified capacity ",name," ",h);flush(stdout)))
    write(joinpath(@__DIR__,name*"_verified_capacity.json"),adaptive_strict_json((wall=time()-start,
        diagnostics=p.diagnostics,settings=(max_degree=64,max_nodes=129,tolerance=.002,orders=(7,11),radius=4.),
        sources=sparse_sources(),source_version=:final,graph_unchanged=before==target_state_fingerprint(a),consistent=false,committed=false)))
end
end