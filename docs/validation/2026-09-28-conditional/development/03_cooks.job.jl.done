include(joinpath(@__DIR__,"../../../estimator/scripts/validate_sampled_online.jl"))
const conditional_development=NamedTuple[]
for case in ONLINE_COMPARISON_CASES
    println("CONDITIONAL CASE ",case.suite);flush(stdout)
    rows=NamedTuple[];started=time()
    try
        model=consistency_model(nx=4,suite=case.suite,stop=maximum(case.times))
        batches,truths=comparison_readings(model,case)
        sm=conditional_init(model;axes=[:a0,:k_spread],orders=(3,5),lag=1,record_limit=0)
        for (i,batch) in enumerate(batches)
            i>3 && break
            result=assimilate!(sm,batch)
            push!(rows,(t=last(batch).t,committed=result.committed,wall=result.wall,diagnostics=result.diagnostics))
            println("CONDITIONAL ARRIVAL ",case.suite," ",last(rows));flush(stdout)
            result.committed || break
            if i==3
                # Development diagnostics only; never feed the truth into inference.
                p=sm.posterior;idx=vcat(collect(p.offsets[sm.anchor.key_z]),collect(p.offsets[last(sm.anchor.nodes)[2]]))
                println("CONDITIONAL ERR ",norm((p.mean[idx]-truths[i])./sqrt.(diag(p.covariance)[idx])));flush(stdout)
            end
        end
        push!(conditional_development,(suite=case.suite,arrivals=rows,wall=time()-started))
    catch err
        showerror(stdout,err,catch_backtrace());println();flush(stdout)
        push!(conditional_development,(suite=case.suite,arrivals=rows,error=sprint(showerror,err),wall=time()-started))
    end
    write(joinpath(@__DIR__,"cook_development.json"),E.json_document((backend=backend_fingerprint(),purpose="development; existing exposed cases; not a consistency study",axes=["a0","k_spread"],orders=[3,5],lag=1,records=conditional_development)))
end