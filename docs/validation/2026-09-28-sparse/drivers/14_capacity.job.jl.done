let F=SparseBenchFinal
    for name in ("core","two_core")
        t=F.frozen(name);a=t.anchor;before=F.target_state_fingerprint(a);start=time()
        p=F.sparse_conditional_fit(a.graph;axes=t.axes,chart=F.AffineChart(t.center,t.scale),lower=[-4.],upper=[4.],
            shape_key=a.key_z,max_nodes=129,max_degree=64,tolerance=.002,orders=(7,11),
            curvature=F.polished_gn_conditional_curvature,step_bounds=Dict(a.key_z=>a.latent_step),newton_tol=E.ONLINE_NEWTON_TOL,
            checkpoint=()->(time()-start<=600 || throw(F.SparseTimeLimit())),progress=h->(println("capacity ",name," ",h);flush(stdout)))
        write(joinpath(@__DIR__,name*"_degree64.json"),F.adaptive_strict_json((wall=time()-start,
            diagnostics=p.diagnostics,settings=(max_degree=64,max_nodes=129,tolerance=.002,orders=(7,11),radius=4.),
            sources=F.sparse_sources(),graph_unchanged=before==F.target_state_fingerprint(a),consistent=false,committed=false)))
    end
end