module DirectRotatedRun
const E=Main.E
using Main.BrisketEstimator, BrisketDynamics, LinearAlgebra, Random, JSON, Statistics, Serialization, Test
include(joinpath(@__DIR__,"../../estimator/scripts/direct_online.jl"))
end
let sm=direct_core_case[1],truth=direct_core_case[3]
    progress=h->(h.evaluations%10000<500 ? (println("ROTATED ",h);flush(stdout)) : nothing)
    global direct_core_rotated=DirectRotatedRun.direct_posterior_fit(sm;max_evaluations=200000,max_seconds=600.,curvature_rotation=true,transport_axes=2,progress)
    p=direct_core_rotated;nz=length(sm.model.blk);target=vcat(truth.z,truth.y);r=core_reference
    comparison=(max_mean_sd=maximum(abs.(p.mean-r.mean)./sqrt.(diag(r.covariance))),
        max_sd_relative=p.diagnostics.moments_valid ? maximum(abs.(sqrt.(diag(p.covariance))./sqrt.(diag(r.covariance)).-1)) : nothing,
        reference_quality=r.diagnostics.mc_precision_ok)
    record=(diagnostics=p.diagnostics,mean=p.mean,covariance=p.covariance,truth=target,comparison=comparison,
        nees_z=p.diagnostics.moments_valid ? DirectRotatedRun.direct_radius(p,target;indices=1:nz)/nz : nothing,
        nees_y=p.diagnostics.moments_valid ? DirectRotatedRun.direct_radius(p,target;indices=nz+1:length(target))/sm.model.bl.n : nothing)
    write(joinpath(@__DIR__,"core_direct_rotated.json"),E.json_document(record))
    println("ROTATED RESULT ",(resolved=p.diagnostics.resolved,reason=p.diagnostics.reason,Z=p.normalizer,eval=p.diagnostics.evaluations,valid=p.diagnostics.moments_valid,wall=p.diagnostics.total_wall,nees=record.nees_y,comparison=comparison));flush(stdout)
end