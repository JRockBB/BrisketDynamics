for suite in (:two_core,:core,:full,:pit_core)
    snap=deserialize(joinpath(@__DIR__,string(suite)*".jls"))
    report=audit_candidate(snap.result.candidate;key=snap.accepted.bank.anchor.key_z,max_components=3,basis=:full)
    write(joinpath(@__DIR__,string(suite)*"_full_curvature.json"),E.json_document((backend=snap.backend,case=snap.case,report=report)))
end
