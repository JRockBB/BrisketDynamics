# Refresh function definitions without replacing serialized candidate types.
src=read(joinpath(@__DIR__,"../../estimator/scripts/adaptive_conditional.jl"),String)
Base.include_string(Main,src[first(findfirst("function adaptive_conditional_fit",src)):end])
include(joinpath(@__DIR__,"../../estimator/scripts/adaptive_curvature.jl"))
println("POLISHED CORE REFINEMENT");flush(stdout)
t=time()
core_polished=adaptive_conditional_fit(core_snapshot.failed.bank.anchor.graph;
    axes=d0.transported.source.axes,center,scale,lower=[-4.],upper=[4.],
    tolerance=.002,max_nodes=129,orders=(7,11),curvature=polished_gn_conditional_curvature,
    step_bounds=Dict(core_snapshot.failed.bank.anchor.key_z=>core_snapshot.failed.bank.anchor.latent_step),
    newton_tol=E.ONLINE_NEWTON_TOL,shape_key=core_snapshot.failed.bank.anchor.key_z,progress=adaptive_progress)
println("POLISHED CORE DONE ",core_polished.density.diagnostics);flush(stdout)
write(joinpath(@__DIR__,"core_polished_gn.json"),E.json_document((wall=time()-t,diagnostics=core_polished.diagnostics)))
serialize(joinpath(@__DIR__,"core_polished_gn.jls"),core_polished)
module PolishedCurvatureTests
const E=Main.E
include(joinpath(@__DIR__,"../../estimator/test/test_adaptive_curvature.jl"))
